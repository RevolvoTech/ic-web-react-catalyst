# Server-only Catalyst backend base URL. Do not expose this as a NEXT_PUBLIC_* value.
# Satellite catalogue and processed-imagery requests always use this backend.
# The legacy GPS state lab can still use a local fixture when it is unset.
CATALYST_BACKEND_URL=http://127.0.0.1:4000

# Public Supabase Auth settings for the signed-in operations view.
# Use the publishable key only. Never put a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ARCGIS_API_KEY=
